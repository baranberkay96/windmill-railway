{
  "name": "Windmill v1 Scripts, Flows and Internal Apps",
  "description": "Turn Python and TS scripts into workflows, UIs and cron jobs with workers.",
  "category": "Automation",
  "tags": [
    "windmill",
    "workflow",
    "automation",
    "scripts",
    "internal-tools",
    "cron",
    "python",
    "typescript"
  ],
  "upstream": {
    "repo": "windmill-labs/windmill",
    "version": "v1.830.0",
    "checked": "2026-10-10"
  },
  "services": {
    "Proxy": {
      "icon": "https://avatars.githubusercontent.com/u/12955528?v=4",
      "source": {
        "repo": "baranberkay96/windmill-railway",
        "rootDirectory": "/services/proxy"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/__proxy/health",
      "healthcheckTimeout": 120,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": null,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8080,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port Caddy listens on; the public domain and the healthcheck target it.",
          "required": false
        },
        "WINDMILL_SERVER_UPSTREAM": {
          "defaultValue": "${{Windmill.RAILWAY_PRIVATE_DOMAIN}}:${{Windmill.PORT}}",
          "description": "Private address of the Windmill server; receives every path except the editor websockets.",
          "required": false
        },
        "WINDMILL_EXTRA_UPSTREAM": {
          "defaultValue": "${{Windmill Extra.RAILWAY_PRIVATE_DOMAIN}}:${{Windmill Extra.PORT}}",
          "description": "Private address of the windmill-extra gateway; receives /ws/*, /ws_debug/* and /ws_mp/*.",
          "required": false
        }
      }
    },
    "Windmill": {
      "icon": "https://avatars.githubusercontent.com/u/98025271?v=4",
      "source": {
        "image": "ghcr.io/windmill-labs/windmill:1.830.0"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/api/health/status",
      "healthcheckTimeout": 600,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": null,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "MODE": {
          "defaultValue": "server",
          "description": "Runs the API server and UI only; jobs run on the worker services.",
          "required": false
        },
        "PORT": {
          "defaultValue": "8000",
          "description": "HTTP port of the Windmill server (Proxy and healthcheck use it).",
          "required": false
        },
        "SERVER_BIND_ADDR": {
          "defaultValue": "::",
          "description": "Bind on all IPv6/IPv4 interfaces so the Railway private network can reach the server.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}?sslmode=disable",
          "description": "Postgres connection string over the private network (TLS off, as in upstream .env).",
          "required": false
        },
        "BASE_URL": {
          "defaultValue": "https://${{Proxy.RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of the instance; Instance settings > Base URL overrides it once saved.",
          "required": false
        },
        "RUST_LOG": {
          "defaultValue": "info",
          "description": "Log level of the Windmill server.",
          "required": false
        }
      }
    },
    "Windmill Worker": {
      "icon": "https://avatars.githubusercontent.com/u/98025271?v=4",
      "source": {
        "image": "ghcr.io/windmill-labs/windmill:1.830.0"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": null,
      "numReplicas": 3,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "MODE": {
          "defaultValue": "worker",
          "description": "Runs a job worker only (no API server).",
          "required": false
        },
        "WORKER_GROUP": {
          "defaultValue": "default",
          "description": "Worker group whose tags and settings (Workers page) this service pulls; runs Python, TS, Bash, Go and other jobs.",
          "required": false
        },
        "NUM_WORKERS": {
          "defaultValue": "1",
          "description": "Workers per replica; Windmill forces 1 outside native mode. Scale with replicas instead.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}?sslmode=disable",
          "description": "Postgres connection string over the private network (the queue lives in Postgres).",
          "required": false
        },
        "BASE_URL": {
          "defaultValue": "https://${{Proxy.RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL used in links that jobs generate (e.g. approval/resume URLs).",
          "required": false
        },
        "FAVOR_UNSHARE_PID": {
          "defaultValue": "true",
          "description": "Upstream default: PID-namespace isolation per job; Windmill logs a warning and runs unisolated if the container does not allow it.",
          "required": false
        },
        "RUST_LOG": {
          "defaultValue": "info",
          "description": "Log level of the worker.",
          "required": false
        }
      }
    },
    "Windmill Native Worker": {
      "icon": "https://avatars.githubusercontent.com/u/98025271?v=4",
      "source": {
        "image": "ghcr.io/windmill-labs/windmill:1.830.0"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": null,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "MODE": {
          "defaultValue": "worker",
          "description": "Runs a job worker only (no API server).",
          "required": false
        },
        "WORKER_GROUP": {
          "defaultValue": "native",
          "description": "Worker group for lightweight in-process jobs (native TS, SQL queries, HTTP calls).",
          "required": false
        },
        "NATIVE_MODE": {
          "defaultValue": "true",
          "description": "Native mode: forces 8 workers per replica and accepts native jobs only (upstream compose setting).",
          "required": false
        },
        "SLEEP_QUEUE": {
          "defaultValue": "200",
          "description": "Milliseconds between queue polls, multiplied by worker count (upstream compose value).",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}?sslmode=disable",
          "description": "Postgres connection string over the private network.",
          "required": false
        },
        "BASE_URL": {
          "defaultValue": "https://${{Proxy.RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL used in links that jobs generate.",
          "required": false
        },
        "RUST_LOG": {
          "defaultValue": "info",
          "description": "Log level of the native worker.",
          "required": false
        }
      }
    },
    "Windmill Extra": {
      "icon": "https://avatars.githubusercontent.com/u/98025271?v=4",
      "source": {
        "image": "ghcr.io/windmill-labs/windmill-extra:1.830.0"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/health",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": null,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "3000",
          "description": "Gateway port; Railway healthchecks /health here (forwarded to the LSP).",
          "required": false
        },
        "GATEWAY_PORT": {
          "defaultValue": "3000",
          "description": "Port of the built-in gateway that fans out /ws/*, /ws_debug/*, /ws_mp/*.",
          "required": false
        },
        "GATEWAY_HOST": {
          "defaultValue": "::",
          "description": "Bind the gateway on all IPv6/IPv4 interfaces for the private network.",
          "required": false
        },
        "ENABLE_LSP": {
          "defaultValue": "true",
          "description": "Language servers for editor autocompletion and diagnostics (Python, TS, Go, Bash).",
          "required": false
        },
        "ENABLE_DEBUGGER": {
          "defaultValue": "true",
          "description": "Step-through debugger for scripts in the editor (upstream compose default).",
          "required": false
        },
        "ENABLE_MULTIPLAYER": {
          "defaultValue": "false",
          "description": "Real-time co-editing; Enterprise Edition only, so off.",
          "required": false
        },
        "ENABLE_NSJAIL": {
          "defaultValue": "false",
          "description": "nsjail for debug sessions needs privileged containers, which Railway does not offer.",
          "required": false
        },
        "REQUIRE_SIGNED_DEBUG_REQUESTS": {
          "defaultValue": "true",
          "description": "Only accept debug sessions signed by the Windmill server. Never set to false on a public deployment.",
          "required": false
        },
        "WINDMILL_BASE_URL": {
          "defaultValue": "http://${{Windmill.RAILWAY_PRIVATE_DOMAIN}}:${{Windmill.PORT}}",
          "description": "Private URL of the Windmill server; the debugger fetches its signing keys from it.",
          "required": false
        },
        "DEBUG_ALLOWED_ORIGINS": {
          "defaultValue": "https://${{Proxy.RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Browser origins allowed to open debugger websockets; add your custom domain here if you add one.",
          "required": false
        }
      }
    },
    "Admin Bootstrap": {
      "icon": "https://avatars.githubusercontent.com/u/98025271?v=4",
      "source": {
        "repo": "baranberkay96/windmill-railway",
        "rootDirectory": "/services/admin-bootstrap"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "WINDMILL_INTERNAL_URL": {
          "defaultValue": "http://${{Windmill.RAILWAY_PRIVATE_DOMAIN}}:${{Windmill.PORT}}",
          "description": "Private URL of the Windmill server used by this one-shot job.",
          "required": false
        },
        "WINDMILL_ADMIN_EMAIL": {
          "defaultValue": "admin@windmill.dev",
          "description": "Seeded superadmin account whose default password the job replaces.",
          "required": false
        },
        "WINDMILL_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Generated first-login password for admin@windmill.dev. Change it after your first login.",
          "required": false
        },
        "BOOTSTRAP_WAIT_SECONDS": {
          "defaultValue": "900",
          "description": "How long the job waits for the server (first boot runs all database migrations).",
          "required": false
        }
      }
    },
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": false
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": false
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": false
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": false
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": false
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "URL to connect to Postgres database.",
          "required": false
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": false
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": false
        }
      }
    }
  },
  "buckets": []
}
